@page
@model WebApplicationRazor.Pages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="./ProductPages/Index">CRUD</a>
</p>
<p>
    <a asp-page="./ProductPages/Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Product[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Product[0].Price)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Product) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Name)
            </td>
            <td>
                @Html.DisplayFor(model => item.Price)
            </td>
            <td>
                <a asp-page="./ProductPages/Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./ProductPages/Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./ProductPages/Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
